{
  "name": "smartbus-travel",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix backend-api ci && npm --prefix web ci && npm run ui:build",
    "dev": "node backend-api/server.js",
    "dev:web": "npm --prefix web run dev",
    "start": "node backend-api/server.js",
    "build": "npm run ui:build && npm run pages:sync",
    "ui:build": "npm --prefix web run build",
    "test": "npm --prefix web test && npm --prefix backend-api test",
    "test:browser": "node scripts/check-browser.cjs",
    "test:simulation": "node --test simulation/preview/traffic-model.test.cjs",
    "test:simulation-browser": "node scripts/check-simulation-browser.cjs",
    "test:map-browser": "node scripts/check-map-browser.cjs",
    "data:public": "node scripts/export-public-data.cjs",
    "check": "npm --prefix web run typecheck && npm --prefix backend-api run check && node scripts/check-syntax.js && node scripts/sync-pages.js --check",
    "db:setup": "node backend-api/scripts/migrate.js --seed",
    "db:migrate": "node backend-api/scripts/migrate.js",
    "pages:sync": "node scripts/sync-pages.js",
    "test:sql": "node backend-api/tests/sql/flows.js"
  },
  "engines": {
    "node": ">=22"
  }
}
